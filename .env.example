# Database
POSTGRES_URL=postgresql://user:password@localhost:5432/elle

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM — "deepseek" (default) or "mistral"
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Embeddings (text-embedding-3-small)
OPENAI_API_KEY=

# Vector store — local server (pnpm chroma) ...
CHROMA_HOST=localhost
CHROMA_PORT=8000
# ... or Chroma Cloud (takes precedence when all three are set)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# File uploads
BLOB_READ_WRITE_TOKEN=
